# Python
__pycache__/
*.py[cod]
.venv/
*.egg-info/
.pytest_cache/
.coverage
coverage.xml
htmlcov/
.hypothesis/
.ruff_cache/

# Node
node_modules/
dist/
# The bundled sidecar: build output of `pnpm --dir agent run bundle`.
agent/build/
# The sidecar staged into the wheel by scripts/stage_sidecar.py. Build output,
# not source — `server/hatch_build.py` refuses to build a wheel without it.
server/src/hephaestus/agent_bridge/_sidecar/
# The canonical schemas/bridge_limits.json staged into hephaestus-core by
# core/hatch_build.py. Build output; the source of truth is schemas/.
core/src/hephaestus/core/_data/
contract/src/hephaestus/contract/_data/

# Hephaestus design-project state
.heph/

# Private reference fixtures (mounted only in the isolated verifier)
corpus/reference/

# Spike scratch outputs
spikes/**/out/

# Playwright artifacts (`pnpm --dir web test:e2e`)
web/playwright-report/
web/test-results/

# Vite dependency-optimizer cache (web/ dev server run from the repo root)
.vite/
