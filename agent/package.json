{
  "name": "@hephaestus/agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Hephaestus Pi sidecar: framing/rpc/limits, generated CAD tools, thread-phase workflows",
  "engines": {
    "node": ">=22.19"
  },
  "packageManager": "pnpm@10.34.5",
  "exports": {
    ".": "./dist/main.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "bundle": "node scripts/bundle.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "lint": "eslint ."
  },
  "dependencies": {
    "@autonome-research/thread-phase": "6.0.0",
    "@earendil-works/pi-ai": "0.80.10",
    "@earendil-works/pi-coding-agent": "0.80.10",
    "@sinclair/typebox": "0.34.52"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^22.10.0",
    "esbuild": "0.28.1",
    "eslint": "^9.17.0",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.20.0",
    "vitest": "^3.0.0"
  }
}
