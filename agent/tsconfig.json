{
  // The BUILD configuration: `rootDir: "src"` + `outDir: "dist"` is what makes
  // the package's `exports` entry `./dist/main.js` resolve. The CHECK runs from
  // `tsconfig.check.json`, which extends this one and adds `test/**` with
  // emission off (J-mirrors-and-dx-28) — so the two never disagree about
  // strictness and the build output is untouched by the wider check.
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022"],
    "rootDir": "src",
    "outDir": "dist",
    "types": ["node"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "forceConsistentCasingInFileNames": true,
    "verbatimModuleSyntax": true,
    "declaration": true,
    "sourceMap": true,
    "skipLibCheck": true
  },
  "include": ["src/**/*.ts"],
  // No `"test"` here: the include above already admits `src/**` only, so
  // excluding the tests was redundant — and, read alongside the check
  // configuration, it now reads as a claim that the tests are unchecked.
  "exclude": ["dist", "node_modules"]
}
