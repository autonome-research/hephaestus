{
  "$id": "https://hephaestus.dev/schemas/tools/ask_user.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Structured question; suspends the loop until answered.",
  "parameters": {
    "additionalProperties": false,
    "properties": {
      "allow_free_text": {
        "default": true,
        "type": "boolean"
      },
      "multi": {
        "default": false,
        "type": "boolean"
      },
      "options": {
        "items": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "additionalProperties": false,
              "properties": {
                "consequence": {
                  "type": "string"
                },
                "label": {
                  "type": "string"
                }
              },
              "required": [
                "label",
                "consequence"
              ],
              "type": "object"
            }
          ]
        },
        "type": "array"
      },
      "question": {
        "type": "string"
      },
      "requirement_ids": {
        "default": [],
        "items": {
          "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,31}$",
          "type": "string"
        },
        "type": "array"
      }
    },
    "required": [
      "question",
      "options"
    ],
    "type": "object"
  },
  "result": {
    "oneOf": [
      {
        "additionalProperties": true,
        "properties": {
          "recorded": {
            "type": "array"
          },
          "selection": {}
        },
        "required": [
          "selection"
        ],
        "type": "object"
      },
      {
        "additionalProperties": true,
        "properties": {
          "code": {
            "const": "clarification_question_shape"
          },
          "message": {
            "type": "string"
          },
          "problems": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "status": {
            "const": "invalid_question"
          }
        },
        "required": [
          "status",
          "code",
          "message",
          "problems"
        ],
        "type": "object"
      }
    ]
  },
  "title": "ask_user",
  "x-hephaestus-tool": {
    "idempotent": false,
    "maxUtf8Fields": {},
    "name": "ask_user",
    "profiles": [
      "part",
      "orchestrator",
      "quick_edit"
    ],
    "sequential": true
  }
}
