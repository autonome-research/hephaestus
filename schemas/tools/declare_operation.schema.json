{
  "$id": "https://hephaestus.dev/schemas/tools/declare_operation.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Declare one machining operation over a tagged feature (CAM.md §3.7).",
  "parameters": {
    "additionalProperties": false,
    "properties": {
      "climb": {
        "default": true,
        "type": "boolean"
      },
      "depth_mm": {
        "type": "number"
      },
      "doc_mm": {
        "anyOf": [
          {
            "type": "number"
          },
          {
            "type": "null"
          }
        ],
        "default": null
      },
      "feature": {
        "pattern": "^[A-Za-z_][A-Za-z0-9_]*(:[^\\s:]+)?$",
        "type": "string"
      },
      "feed_mm_min": {
        "anyOf": [
          {
            "type": "number"
          },
          {
            "type": "null"
          }
        ],
        "default": null
      },
      "id": {
        "pattern": "^[A-Za-z][A-Za-z0-9._-]{0,63}$",
        "type": "string"
      },
      "kind": {
        "enum": [
          "drill",
          "pocket",
          "profile",
          "face"
        ],
        "type": "string"
      },
      "note": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null
      },
      "plunge_mm_min": {
        "anyOf": [
          {
            "type": "number"
          },
          {
            "type": "null"
          }
        ],
        "default": null
      },
      "provenance": {
        "additionalProperties": false,
        "properties": {
          "assumed": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "default": null
          },
          "reason": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null
          },
          "requirement": {
            "anyOf": [
              {
                "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,31}$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null
          }
        },
        "required": [],
        "type": "object"
      },
      "rpm": {
        "anyOf": [
          {
            "type": "number"
          },
          {
            "type": "null"
          }
        ],
        "default": null
      },
      "setup": {
        "pattern": "^[A-Za-z][A-Za-z0-9._-]{0,63}$",
        "type": "string"
      },
      "stepdown_mm": {
        "anyOf": [
          {
            "type": "number"
          },
          {
            "type": "null"
          }
        ],
        "default": null
      },
      "stepover_mm": {
        "anyOf": [
          {
            "type": "number"
          },
          {
            "type": "null"
          }
        ],
        "default": null
      },
      "tabs": {
        "anyOf": [
          {
            "additionalProperties": false,
            "properties": {
              "count": {
                "type": "integer"
              },
              "height_mm": {
                "type": "number"
              },
              "width_mm": {
                "type": "number"
              }
            },
            "required": [
              "count",
              "width_mm",
              "height_mm"
            ],
            "type": "object"
          },
          {
            "type": "null"
          }
        ],
        "default": null
      },
      "tool": {
        "pattern": "^[A-Za-z][A-Za-z0-9._-]{0,63}$",
        "type": "string"
      },
      "woc_mm": {
        "anyOf": [
          {
            "type": "number"
          },
          {
            "type": "null"
          }
        ],
        "default": null
      }
    },
    "required": [
      "id",
      "setup",
      "kind",
      "feature",
      "tool",
      "depth_mm",
      "provenance"
    ],
    "type": "object"
  },
  "result": {
    "additionalProperties": true,
    "properties": {
      "artifact_ref": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ]
      },
      "change": {
        "anyOf": [
          {
            "type": "object"
          },
          {
            "type": "null"
          }
        ]
      },
      "entries": {
        "items": {
          "type": "object"
        },
        "type": "array"
      },
      "generation": {
        "type": "integer"
      },
      "status": {
        "const": "ok"
      }
    },
    "required": [
      "status",
      "generation",
      "entries"
    ],
    "type": "object"
  },
  "title": "declare_operation",
  "x-hephaestus-tool": {
    "idempotent": true,
    "maxUtf8Fields": {},
    "name": "declare_operation",
    "profiles": [
      "part",
      "orchestrator"
    ],
    "sequential": true
  }
}
