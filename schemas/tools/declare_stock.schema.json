{
  "$id": "https://hephaestus.dev/schemas/tools/declare_stock.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Declare one stock record (CAM.md §3.2); advances one generation.",
  "parameters": {
    "additionalProperties": false,
    "properties": {
      "extents_mm": {
        "items": {
          "type": "number"
        },
        "maxItems": 3,
        "minItems": 3,
        "type": "array"
      },
      "id": {
        "pattern": "^[A-Za-z][A-Za-z0-9._-]{0,63}$",
        "type": "string"
      },
      "kind": {
        "enum": [
          "rectangular"
        ],
        "type": "string"
      },
      "material": {
        "type": "string"
      },
      "note": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null
      },
      "origin_anchor": {
        "pattern": "^[A-Za-z_][A-Za-z0-9_]*(:[^\\s:]+)?$",
        "type": "string"
      },
      "origin_offset_mm": {
        "anyOf": [
          {
            "items": {
              "type": "number"
            },
            "maxItems": 3,
            "minItems": 3,
            "type": "array"
          },
          {
            "type": "null"
          }
        ],
        "default": null
      },
      "provenance": {
        "additionalProperties": false,
        "properties": {
          "assumed": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "default": null
          },
          "reason": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null
          },
          "requirement": {
            "anyOf": [
              {
                "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,31}$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null
          }
        },
        "required": [],
        "type": "object"
      }
    },
    "required": [
      "id",
      "kind",
      "extents_mm",
      "origin_anchor",
      "material",
      "provenance"
    ],
    "type": "object"
  },
  "result": {
    "additionalProperties": true,
    "properties": {
      "artifact_ref": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ]
      },
      "change": {
        "anyOf": [
          {
            "type": "object"
          },
          {
            "type": "null"
          }
        ]
      },
      "entries": {
        "items": {
          "type": "object"
        },
        "type": "array"
      },
      "generation": {
        "type": "integer"
      },
      "status": {
        "const": "ok"
      }
    },
    "required": [
      "status",
      "generation",
      "entries"
    ],
    "type": "object"
  },
  "title": "declare_stock",
  "x-hephaestus-tool": {
    "idempotent": true,
    "maxUtf8Fields": {},
    "name": "declare_stock",
    "profiles": [
      "part",
      "orchestrator"
    ],
    "sequential": true
  }
}
