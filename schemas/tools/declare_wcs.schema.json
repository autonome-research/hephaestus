{
  "$id": "https://hephaestus.dev/schemas/tools/declare_wcs.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Declare one work coordinate system (CAM.md §3.4); advances one generation.",
  "parameters": {
    "additionalProperties": false,
    "properties": {
      "code": {
        "type": "string"
      },
      "datum": {
        "pattern": "^[A-Za-z_][A-Za-z0-9_]*(:[^\\s:]+)?$",
        "type": "string"
      },
      "id": {
        "pattern": "^[A-Za-z][A-Za-z0-9._-]{0,63}$",
        "type": "string"
      },
      "note": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null
      },
      "provenance": {
        "additionalProperties": false,
        "properties": {
          "assumed": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "default": null
          },
          "reason": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null
          },
          "requirement": {
            "anyOf": [
              {
                "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,31}$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null
          }
        },
        "required": [],
        "type": "object"
      },
      "z_zero": {
        "enum": [
          "stock_top",
          "part_top",
          "datum"
        ],
        "type": "string"
      }
    },
    "required": [
      "id",
      "code",
      "datum",
      "z_zero",
      "provenance"
    ],
    "type": "object"
  },
  "result": {
    "additionalProperties": true,
    "properties": {
      "artifact_ref": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ]
      },
      "change": {
        "anyOf": [
          {
            "type": "object"
          },
          {
            "type": "null"
          }
        ]
      },
      "entries": {
        "items": {
          "type": "object"
        },
        "type": "array"
      },
      "generation": {
        "type": "integer"
      },
      "status": {
        "const": "ok"
      }
    },
    "required": [
      "status",
      "generation",
      "entries"
    ],
    "type": "object"
  },
  "title": "declare_wcs",
  "x-hephaestus-tool": {
    "idempotent": true,
    "maxUtf8Fields": {},
    "name": "declare_wcs",
    "profiles": [
      "part",
      "orchestrator"
    ],
    "sequential": true
  }
}
