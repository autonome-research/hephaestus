{
  "$id": "https://hephaestus.dev/schemas/tools/delegate_part_agent.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Delegate a prompt to an existing part's leased session (orchestrator only).",
  "parameters": {
    "additionalProperties": false,
    "properties": {
      "deadline_seconds": {
        "default": 600,
        "maximum": 1200,
        "minimum": 1,
        "type": "integer"
      },
      "delivery": {
        "default": "prompt",
        "enum": [
          "prompt",
          "follow_up"
        ],
        "type": "string"
      },
      "part": {
        "pattern": "^[a-z][a-z0-9_]{0,63}$",
        "type": "string"
      },
      "prompt": {
        "type": "string",
        "x-hephaestus-maxUtf8Bytes": 32768
      }
    },
    "required": [
      "part",
      "prompt"
    ],
    "type": "object"
  },
  "result": {
    "oneOf": [
      {
        "additionalProperties": true,
        "properties": {
          "child_run_id": {
            "type": "string"
          },
          "delegation_ref": {
            "type": "string"
          },
          "part_session_id": {
            "type": "string"
          },
          "result_artifact_ref": {
            "type": "string"
          },
          "status": {
            "const": "completed"
          }
        },
        "required": [
          "status",
          "part_session_id",
          "child_run_id",
          "delegation_ref"
        ],
        "type": "object"
      },
      {
        "additionalProperties": true,
        "properties": {
          "child_run_id": {
            "type": "string"
          },
          "delegation_ref": {
            "type": "string"
          },
          "part_session_id": {
            "type": "string"
          },
          "status": {
            "const": "queued"
          }
        },
        "required": [
          "status",
          "part_session_id",
          "child_run_id",
          "delegation_ref"
        ],
        "type": "object"
      },
      {
        "additionalProperties": true,
        "properties": {
          "child_run_id": {
            "type": "string"
          },
          "delegation_ref": {
            "type": "string"
          },
          "error": {},
          "part_session_id": {
            "type": "string"
          },
          "status": {
            "enum": [
              "failed",
              "cancelled",
              "timed_out",
              "interrupted"
            ]
          }
        },
        "required": [
          "status",
          "part_session_id",
          "child_run_id",
          "delegation_ref"
        ],
        "type": "object"
      },
      {
        "additionalProperties": true,
        "properties": {
          "part_session_id": {
            "type": "string"
          },
          "reason": {
            "enum": [
              "part_busy",
              "queue_full",
              "no_run_slot",
              "prompt_too_large",
              "scope_denied",
              "session_busy",
              "invalid_part"
            ],
            "type": "string"
          },
          "status": {
            "const": "rejected"
          }
        },
        "required": [
          "status",
          "reason"
        ],
        "type": "object"
      }
    ]
  },
  "title": "delegate_part_agent",
  "x-hephaestus-tool": {
    "idempotent": true,
    "maxUtf8Fields": {
      "prompt": 32768
    },
    "name": "delegate_part_agent",
    "profiles": [
      "orchestrator"
    ],
    "sequential": true
  }
}
