{
  "$id": "https://hephaestus.dev/schemas/tools/instance_store_part.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Instance a store generator, returning a placed script fragment.",
  "parameters": {
    "additionalProperties": false,
    "properties": {
      "id": {
        "type": "string"
      },
      "instance": {
        "anyOf": [
          {
            "pattern": "^[a-z][a-z0-9_]{0,63}$",
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null
      },
      "params": {
        "type": "object"
      },
      "pos": {
        "anyOf": [
          {
            "type": "object"
          },
          {
            "type": "null"
          }
        ],
        "default": null
      }
    },
    "required": [
      "id",
      "params"
    ],
    "type": "object"
  },
  "result": {
    "oneOf": [
      {
        "additionalProperties": true,
        "properties": {
          "claims": {
            "type": "string"
          },
          "datasheet": {
            "type": "object"
          },
          "interfaces": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "mass": {
            "type": "object"
          },
          "script_fragment": {
            "type": "string"
          }
        },
        "required": [
          "script_fragment"
        ],
        "type": "object"
      },
      {
        "additionalProperties": true,
        "properties": {
          "code": {
            "const": "capability_not_available"
          },
          "message": {
            "type": "string"
          },
          "status": {
            "const": "capability_error"
          }
        },
        "required": [
          "status",
          "code"
        ],
        "type": "object"
      }
    ]
  },
  "title": "instance_store_part",
  "x-hephaestus-tool": {
    "idempotent": false,
    "maxUtf8Fields": {},
    "name": "instance_store_part",
    "profiles": [
      "part",
      "orchestrator",
      "quick_edit"
    ],
    "sequential": false
  }
}
