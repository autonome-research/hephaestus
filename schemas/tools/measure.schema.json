{
  "$id": "https://hephaestus.dev/schemas/tools/measure.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Metric facade: interference/clearance/distance/bbox/volume/mass/sealed/genus.",
  "parameters": {
    "additionalProperties": false,
    "allOf": [
      {
        "else": {
          "properties": {
            "b": {
              "type": "null"
            }
          }
        },
        "if": {
          "properties": {
            "kind": {
              "enum": [
                "interference",
                "clearance",
                "distance"
              ]
            }
          },
          "required": [
            "kind"
          ]
        },
        "then": {
          "properties": {
            "b": {
              "type": "string"
            }
          },
          "required": [
            "b"
          ]
        }
      },
      {
        "not": {
          "required": [
            "artifact_ref",
            "project_snapshot_ref"
          ]
        }
      },
      {
        "if": {
          "not": {
            "properties": {
              "kind": {
                "const": "mass"
              }
            },
            "required": [
              "kind"
            ]
          }
        },
        "then": {
          "properties": {
            "density": {
              "type": "null"
            }
          }
        }
      }
    ],
    "properties": {
      "a": {
        "type": "string"
      },
      "artifact_ref": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null
      },
      "b": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null
      },
      "density": {
        "anyOf": [
          {
            "exclusiveMinimum": 0,
            "type": "number"
          },
          {
            "type": "null"
          }
        ],
        "default": null
      },
      "kind": {
        "enum": [
          "interference",
          "clearance",
          "distance",
          "bbox",
          "volume",
          "mass",
          "sealed",
          "genus"
        ],
        "type": "string"
      },
      "part": {
        "anyOf": [
          {
            "pattern": "^[a-z][a-z0-9_]{0,63}$",
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null
      },
      "project_snapshot_ref": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null
      }
    },
    "required": [
      "kind",
      "a"
    ],
    "type": "object"
  },
  "result": {
    "additionalProperties": true,
    "properties": {
      "detail": {
        "additionalProperties": true,
        "properties": {
          "args": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "density": {
            "additionalProperties": true,
            "properties": {
              "g_per_mm3": {
                "type": "number"
              },
              "material": {
                "additionalProperties": true,
                "properties": {
                  "density_kg_m3": {
                    "type": "number"
                  },
                  "id": {
                    "type": "string"
                  },
                  "name": {
                    "type": "string"
                  },
                  "registry": {
                    "type": "string"
                  },
                  "registry_digest": {
                    "type": "string"
                  },
                  "spec": {
                    "type": "string"
                  }
                },
                "required": [
                  "id",
                  "density_kg_m3"
                ],
                "type": "object"
              },
              "part": {
                "type": "string"
              },
              "source": {
                "enum": [
                  "materials_registry",
                  "explicit"
                ],
                "type": "string"
              }
            },
            "required": [
              "part",
              "g_per_mm3",
              "source"
            ],
            "type": "object"
          },
          "kind": {
            "type": "string"
          },
          "measured": {},
          "parts": {
            "items": {
              "type": "string"
            },
            "type": "array"
          }
        },
        "required": [],
        "type": "object"
      },
      "resolved_artifact_refs": {
        "items": {
          "type": "string"
        },
        "type": "array"
      },
      "units": {
        "type": "string"
      },
      "value": {}
    },
    "required": [
      "value",
      "units"
    ],
    "type": "object"
  },
  "title": "measure",
  "x-hephaestus-tool": {
    "idempotent": false,
    "maxUtf8Fields": {},
    "name": "measure",
    "profiles": [
      "part",
      "orchestrator",
      "quick_edit",
      "reviewer"
    ],
    "sequential": false
  }
}
