{
  "$id": "https://hephaestus.dev/schemas/tools/propose_placement.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Propose rigid placements for declared free parts as a verified, provenance-carrying artifact that nothing applies (SOLVER.md §2B).",
  "parameters": {
    "additionalProperties": false,
    "properties": {
      "box": {
        "anyOf": [
          {
            "additionalProperties": {
              "items": {
                "anyOf": [
                  {
                    "type": "number"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "maxItems": 2,
              "minItems": 2,
              "type": "array"
            },
            "propertyNames": {
              "pattern": "^[A-Za-z_][A-Za-z0-9_]*\\.(tx|ty|tz|rx|ry|rz)$",
              "type": "string"
            },
            "type": "object"
          },
          {
            "type": "null"
          }
        ],
        "default": null
      },
      "build_budget": {
        "anyOf": [
          {
            "type": "integer"
          },
          {
            "type": "null"
          }
        ],
        "default": null
      },
      "ceiling": {
        "anyOf": [
          {
            "type": "integer"
          },
          {
            "type": "null"
          }
        ],
        "default": null
      },
      "constraints": {
        "items": {
          "pattern": "^[A-Za-z][A-Za-z0-9._-]{0,63}$",
          "type": "string"
        },
        "minItems": 1,
        "type": "array"
      },
      "free": {
        "items": {
          "pattern": "^[A-Za-z_][A-Za-z0-9_.]*$",
          "type": "string"
        },
        "minItems": 1,
        "type": "array"
      },
      "ground": {
        "anyOf": [
          {
            "items": {
              "pattern": "^[a-z][a-z0-9_]{0,63}$",
              "type": "string"
            },
            "type": "array"
          },
          {
            "type": "null"
          }
        ],
        "default": null
      },
      "provenance": {
        "additionalProperties": false,
        "properties": {
          "assumed": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "default": null
          },
          "reason": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null
          },
          "requirement": {
            "anyOf": [
              {
                "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,31}$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null
          }
        },
        "required": [],
        "type": "object"
      },
      "regularization": {
        "enum": [
          "min_norm_from_start"
        ],
        "type": "string"
      },
      "space": {
        "enum": [
          "transform",
          "parameters"
        ],
        "type": "string"
      },
      "starts": {
        "anyOf": [
          {
            "items": {
              "additionalProperties": false,
              "properties": {
                "id": {
                  "pattern": "^[a-z][a-z0-9_]{0,63}$",
                  "type": "string"
                },
                "values": {
                  "anyOf": [
                    {
                      "additionalProperties": {
                        "type": "number"
                      },
                      "type": "object"
                    },
                    {
                      "type": "null"
                    }
                  ],
                  "default": null
                }
              },
              "required": [
                "id"
              ],
              "type": "object"
            },
            "type": "array"
          },
          {
            "type": "null"
          }
        ],
        "default": null
      },
      "tol": {
        "exclusiveMinimum": 0,
        "type": "number"
      },
      "weighting": {
        "enum": [
          "unit_scaled_v1",
          "declared"
        ],
        "type": "string"
      },
      "weights": {
        "anyOf": [
          {
            "additionalProperties": false,
            "properties": {
              "deg": {
                "type": "number"
              },
              "mm": {
                "type": "number"
              }
            },
            "required": [
              "mm",
              "deg"
            ],
            "type": "object"
          },
          {
            "type": "null"
          }
        ],
        "default": null
      }
    },
    "required": [
      "space",
      "constraints",
      "free",
      "weighting",
      "regularization",
      "tol",
      "provenance"
    ],
    "type": "object"
  },
  "result": {
    "additionalProperties": true,
    "properties": {
      "artifact_refs": {
        "additionalProperties": {
          "type": "string"
        },
        "type": "object"
      },
      "constraint_generation": {
        "type": "integer"
      },
      "detail": {
        "type": "string"
      },
      "joint_generation": {
        "type": "integer"
      },
      "nonsmooth_terms": {
        "items": {
          "type": "string"
        },
        "type": "array"
      },
      "placements": {
        "items": {
          "type": "object"
        },
        "type": "array"
      },
      "proposal_id": {
        "type": "string"
      },
      "proposal_ref": {
        "type": "string"
      },
      "reason": {
        "type": "string"
      },
      "request": {
        "type": "object"
      },
      "solver_core": {
        "type": "object"
      },
      "solver_trace_ref": {
        "type": "string"
      },
      "space": {
        "type": "string"
      },
      "status": {
        "const": "ok"
      },
      "subject": {
        "type": "string"
      },
      "verdict": {
        "type": "string"
      },
      "verification": {
        "type": "object"
      }
    },
    "required": [
      "status",
      "verdict",
      "space",
      "placements",
      "solver_core",
      "verification"
    ],
    "type": "object"
  },
  "title": "propose_placement",
  "x-hephaestus-tool": {
    "idempotent": true,
    "maxUtf8Fields": {},
    "name": "propose_placement",
    "profiles": [
      "orchestrator"
    ],
    "sequential": true
  }
}
