{
  "$id": "https://hephaestus.dev/schemas/tools/search_parts_store.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Search parametric hardware generators in the pinned parts store.",
  "parameters": {
    "additionalProperties": false,
    "properties": {
      "max_results": {
        "default": 5,
        "minimum": 1,
        "type": "integer"
      },
      "query": {
        "type": "string"
      }
    },
    "required": [
      "query"
    ],
    "type": "object"
  },
  "result": {
    "items": {
      "additionalProperties": true,
      "properties": {
        "component_class": {
          "type": "string"
        },
        "has_datasheet": {
          "type": "boolean"
        },
        "id": {
          "type": "string"
        },
        "interfaces": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "class": {
                "type": "string"
              },
              "name": {
                "type": "string"
              },
              "role": {
                "type": "string"
              }
            },
            "required": [
              "name",
              "class",
              "role"
            ],
            "type": "object"
          },
          "type": "array"
        },
        "mass_g": {
          "type": "number"
        },
        "name": {
          "type": "string"
        },
        "params": {
          "type": "object"
        },
        "preview": {
          "type": "string"
        },
        "series": {
          "type": "object"
        }
      },
      "required": [
        "id",
        "name"
      ],
      "type": "object"
    },
    "type": "array"
  },
  "title": "search_parts_store",
  "x-hephaestus-tool": {
    "idempotent": false,
    "maxUtf8Fields": {},
    "name": "search_parts_store",
    "profiles": [
      "part",
      "orchestrator",
      "quick_edit"
    ],
    "sequential": false
  }
}
