{
  "$id": "https://hephaestus.dev/schemas/tools/solve_pose.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Solve free joint parameters for declared targets; a verified proposal, never applied (SOLVER.md §2A).",
  "parameters": {
    "additionalProperties": false,
    "properties": {
      "ceiling": {
        "anyOf": [
          {
            "type": "integer"
          },
          {
            "type": "null"
          }
        ],
        "default": null
      },
      "free_joints": {
        "anyOf": [
          {
            "items": {
              "pattern": "^[A-Za-z][A-Za-z0-9._-]{0,63}$",
              "type": "string"
            },
            "type": "array"
          },
          {
            "type": "null"
          }
        ],
        "default": null
      },
      "provenance": {
        "additionalProperties": false,
        "properties": {
          "assumed": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "default": null
          },
          "reason": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null
          },
          "requirement": {
            "anyOf": [
              {
                "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,31}$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null
          }
        },
        "required": [],
        "type": "object"
      },
      "regularization": {
        "enum": [
          "min_norm_from_start"
        ],
        "type": "string"
      },
      "starts": {
        "anyOf": [
          {
            "items": {
              "additionalProperties": false,
              "properties": {
                "id": {
                  "pattern": "^[a-z][a-z0-9_]{0,63}$",
                  "type": "string"
                },
                "values": {
                  "anyOf": [
                    {
                      "additionalProperties": {
                        "type": "number"
                      },
                      "type": "object"
                    },
                    {
                      "type": "null"
                    }
                  ],
                  "default": null
                }
              },
              "required": [
                "id"
              ],
              "type": "object"
            },
            "type": "array"
          },
          {
            "type": "null"
          }
        ],
        "default": null
      },
      "targets": {
        "items": {
          "anyOf": [
            {
              "additionalProperties": false,
              "properties": {
                "anchor": {
                  "pattern": "^[A-Za-z_][A-Za-z0-9_]*(:[^\\s:]+)?$",
                  "type": "string"
                },
                "form": {
                  "const": "anchor_point"
                },
                "id": {
                  "pattern": "^[a-z][a-z0-9_]{0,63}$",
                  "type": "string"
                },
                "point_mm": {
                  "items": {
                    "type": "number"
                  },
                  "maxItems": 3,
                  "minItems": 3,
                  "type": "array"
                },
                "tol_mm": {
                  "exclusiveMinimum": 0,
                  "type": "number"
                }
              },
              "required": [
                "form",
                "id",
                "anchor",
                "point_mm",
                "tol_mm"
              ],
              "type": "object"
            },
            {
              "additionalProperties": false,
              "properties": {
                "constraint_id": {
                  "pattern": "^[a-z][a-z0-9_]{0,63}$",
                  "type": "string"
                },
                "form": {
                  "const": "constraint"
                }
              },
              "required": [
                "form",
                "constraint_id"
              ],
              "type": "object"
            }
          ]
        },
        "minItems": 1,
        "type": "array"
      },
      "tol": {
        "exclusiveMinimum": 0,
        "type": "number"
      },
      "weighting": {
        "enum": [
          "unit_scaled_v1",
          "declared"
        ],
        "type": "string"
      },
      "weights": {
        "anyOf": [
          {
            "additionalProperties": false,
            "properties": {
              "deg": {
                "type": "number"
              },
              "mm": {
                "type": "number"
              }
            },
            "required": [
              "mm",
              "deg"
            ],
            "type": "object"
          },
          {
            "type": "null"
          }
        ],
        "default": null
      }
    },
    "required": [
      "targets",
      "weighting",
      "regularization",
      "tol",
      "provenance"
    ],
    "type": "object"
  },
  "result": {
    "additionalProperties": true,
    "properties": {
      "artifact_refs": {
        "additionalProperties": {
          "type": "string"
        },
        "type": "object"
      },
      "assignments": {
        "items": {
          "type": "object"
        },
        "type": "array"
      },
      "constraint_generation": {
        "type": "integer"
      },
      "detail": {
        "type": "string"
      },
      "joint_generation": {
        "type": "integer"
      },
      "reason": {
        "type": "string"
      },
      "request": {
        "type": "object"
      },
      "solver_core": {
        "type": "object"
      },
      "space": {
        "const": "pose"
      },
      "status": {
        "const": "ok"
      },
      "subject": {
        "type": "string"
      },
      "verdict": {
        "type": "string"
      },
      "verification": {
        "type": "object"
      }
    },
    "required": [
      "status",
      "verdict",
      "space",
      "assignments",
      "solver_core",
      "verification"
    ],
    "type": "object"
  },
  "title": "solve_pose",
  "x-hephaestus-tool": {
    "idempotent": true,
    "maxUtf8Fields": {},
    "name": "solve_pose",
    "profiles": [
      "part",
      "orchestrator"
    ],
    "sequential": false
  }
}
