{
  "$id": "https://hephaestus.dev/schemas/tools/update_operation.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Revise or withdraw one operation with a recorded reason; one generation.",
  "parameters": {
    "additionalProperties": false,
    "properties": {
      "id": {
        "pattern": "^[A-Za-z][A-Za-z0-9._-]{0,63}$",
        "type": "string"
      },
      "patch": {
        "additionalProperties": false,
        "properties": {
          "climb": {
            "anyOf": [
              {
                "default": true,
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ]
          },
          "depth_mm": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ]
          },
          "doc_mm": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "default": null
          },
          "feature": {
            "anyOf": [
              {
                "pattern": "^[A-Za-z_][A-Za-z0-9_]*(:[^\\s:]+)?$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "feed_mm_min": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "default": null
          },
          "kind": {
            "anyOf": [
              {
                "enum": [
                  "drill",
                  "pocket",
                  "profile",
                  "face"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "note": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null
          },
          "plunge_mm_min": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "default": null
          },
          "provenance": {
            "anyOf": [
              {
                "additionalProperties": false,
                "properties": {
                  "assumed": {
                    "anyOf": [
                      {
                        "type": "boolean"
                      },
                      {
                        "type": "null"
                      }
                    ],
                    "default": null
                  },
                  "reason": {
                    "anyOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "null"
                      }
                    ],
                    "default": null
                  },
                  "requirement": {
                    "anyOf": [
                      {
                        "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,31}$",
                        "type": "string"
                      },
                      {
                        "type": "null"
                      }
                    ],
                    "default": null
                  }
                },
                "required": [],
                "type": "object"
              },
              {
                "type": "null"
              }
            ]
          },
          "rpm": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "default": null
          },
          "setup": {
            "anyOf": [
              {
                "pattern": "^[A-Za-z][A-Za-z0-9._-]{0,63}$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "stepdown_mm": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "default": null
          },
          "stepover_mm": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "default": null
          },
          "tabs": {
            "anyOf": [
              {
                "additionalProperties": false,
                "properties": {
                  "count": {
                    "type": "integer"
                  },
                  "height_mm": {
                    "type": "number"
                  },
                  "width_mm": {
                    "type": "number"
                  }
                },
                "required": [
                  "count",
                  "width_mm",
                  "height_mm"
                ],
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "default": null
          },
          "tool": {
            "anyOf": [
              {
                "pattern": "^[A-Za-z][A-Za-z0-9._-]{0,63}$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "withdrawn": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ]
          },
          "woc_mm": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "default": null
          }
        },
        "required": [],
        "type": "object"
      },
      "reason": {
        "type": "string"
      }
    },
    "required": [
      "id",
      "patch",
      "reason"
    ],
    "type": "object"
  },
  "result": {
    "additionalProperties": true,
    "properties": {
      "artifact_ref": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ]
      },
      "change": {
        "anyOf": [
          {
            "type": "object"
          },
          {
            "type": "null"
          }
        ]
      },
      "entries": {
        "items": {
          "type": "object"
        },
        "type": "array"
      },
      "generation": {
        "type": "integer"
      },
      "status": {
        "const": "ok"
      }
    },
    "required": [
      "status",
      "generation",
      "entries"
    ],
    "type": "object"
  },
  "title": "update_operation",
  "x-hephaestus-tool": {
    "idempotent": true,
    "maxUtf8Fields": {},
    "name": "update_operation",
    "profiles": [
      "part",
      "orchestrator"
    ],
    "sequential": true
  }
}
