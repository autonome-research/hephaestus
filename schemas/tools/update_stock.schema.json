{
  "$id": "https://hephaestus.dev/schemas/tools/update_stock.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Revise or withdraw one stock record with a recorded reason; one generation.",
  "parameters": {
    "additionalProperties": false,
    "properties": {
      "id": {
        "pattern": "^[A-Za-z][A-Za-z0-9._-]{0,63}$",
        "type": "string"
      },
      "patch": {
        "additionalProperties": false,
        "properties": {
          "extents_mm": {
            "anyOf": [
              {
                "items": {
                  "type": "number"
                },
                "maxItems": 3,
                "minItems": 3,
                "type": "array"
              },
              {
                "type": "null"
              }
            ]
          },
          "kind": {
            "anyOf": [
              {
                "enum": [
                  "rectangular"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "material": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "note": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null
          },
          "origin_anchor": {
            "anyOf": [
              {
                "pattern": "^[A-Za-z_][A-Za-z0-9_]*(:[^\\s:]+)?$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "origin_offset_mm": {
            "anyOf": [
              {
                "items": {
                  "type": "number"
                },
                "maxItems": 3,
                "minItems": 3,
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "default": null
          },
          "provenance": {
            "anyOf": [
              {
                "additionalProperties": false,
                "properties": {
                  "assumed": {
                    "anyOf": [
                      {
                        "type": "boolean"
                      },
                      {
                        "type": "null"
                      }
                    ],
                    "default": null
                  },
                  "reason": {
                    "anyOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "null"
                      }
                    ],
                    "default": null
                  },
                  "requirement": {
                    "anyOf": [
                      {
                        "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,31}$",
                        "type": "string"
                      },
                      {
                        "type": "null"
                      }
                    ],
                    "default": null
                  }
                },
                "required": [],
                "type": "object"
              },
              {
                "type": "null"
              }
            ]
          },
          "withdrawn": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [],
        "type": "object"
      },
      "reason": {
        "type": "string"
      }
    },
    "required": [
      "id",
      "patch",
      "reason"
    ],
    "type": "object"
  },
  "result": {
    "additionalProperties": true,
    "properties": {
      "artifact_ref": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ]
      },
      "change": {
        "anyOf": [
          {
            "type": "object"
          },
          {
            "type": "null"
          }
        ]
      },
      "entries": {
        "items": {
          "type": "object"
        },
        "type": "array"
      },
      "generation": {
        "type": "integer"
      },
      "status": {
        "const": "ok"
      }
    },
    "required": [
      "status",
      "generation",
      "entries"
    ],
    "type": "object"
  },
  "title": "update_stock",
  "x-hephaestus-tool": {
    "idempotent": true,
    "maxUtf8Fields": {},
    "name": "update_stock",
    "profiles": [
      "part",
      "orchestrator"
    ],
    "sequential": true
  }
}
