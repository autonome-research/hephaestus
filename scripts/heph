#!/usr/bin/env bash
# Copyright 2026 The Hephaestus Authors
# SPDX-License-Identifier: Apache-2.0
#
# A launcher for this checkout's `heph`, safe to symlink onto PATH:
#
#     ln -s /path/to/hephaestus/scripts/heph ~/bin/heph
#
# It resolves the clone from its own location (through symlinks), so it works
# from any working directory — unlike `uv run heph`, which needs the clone as
# cwd. It execs the venv binary directly: no uv resolution on every invocation.

set -euo pipefail

source=${BASH_SOURCE[0]}
while [ -L "$source" ]; do
	dir=$(cd -P -- "$(dirname -- "$source")" && pwd -P)
	source=$(readlink -- "$source")
	case $source in
	/*) ;;
	*) source=$dir/$source ;;
	esac
done
script_dir=$(cd -P -- "$(dirname -- "$source")" && pwd -P)
repo_root=$(cd -P -- "$script_dir/.." && pwd -P)

heph_bin=$repo_root/.venv/bin/heph
if [ ! -x "$heph_bin" ]; then
	printf 'error: %s is missing. Build the checkout first:\n    %s\n' \
		"$heph_bin" "$script_dir/bootstrap.sh" >&2
	exit 1
fi

exec "$heph_bin" "$@"
